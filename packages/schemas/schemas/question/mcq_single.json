{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allingo.vn/schemas/question/mcq_single.json",
  "title": "Allingo question content: Mcq Single",
  "description": "Nội dung câu hỏi dạng \"mcq_single\" lưu trong catalog.question_versions.content (JSONB). Sinh tự động từ packages/schemas/src/question/content.ts – không sửa tay.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "mcq_single"
    },
    "stem": {
      "default": "",
      "type": "string",
      "maxLength": 8000
    },
    "stem_i18n": {
      "type": "object",
      "properties": {
        "vi": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "ja": {
          "type": "string"
        },
        "ko": {
          "type": "string"
        },
        "th": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "audio_asset_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "image_asset_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "listen_policy": {
          "default": "free",
          "type": "string",
          "enum": [
            "once",
            "free"
          ]
        },
        "pause_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "explanation": {
      "type": "object",
      "properties": {
        "vi": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "ja": {
          "type": "string"
        },
        "ko": {
          "type": "string"
        },
        "th": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "string",
      "maxLength": 4000
    },
    "tags": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "options": {
      "minItems": 2,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "image_asset_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "audio_asset_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "key",
          "text"
        ]
      }
    },
    "answer_key": {
      "type": "object",
      "properties": {
        "correct": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "correct"
      ]
    }
  },
  "required": [
    "type",
    "options",
    "answer_key"
  ]
}
