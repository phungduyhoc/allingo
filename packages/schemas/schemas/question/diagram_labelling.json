{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allingo.vn/schemas/question/diagram_labelling.json",
  "title": "Allingo question content: Diagram Labelling",
  "description": "Nội dung câu hỏi dạng \"diagram_labelling\" lưu trong catalog.question_versions.content (JSONB). Sinh tự động từ packages/schemas/src/question/content.ts – không sửa tay.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "diagram_labelling"
    },
    "stem": {
      "default": "",
      "type": "string",
      "maxLength": 8000
    },
    "stem_i18n": {
      "type": "object",
      "properties": {
        "vi": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "ja": {
          "type": "string"
        },
        "ko": {
          "type": "string"
        },
        "th": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "audio_asset_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "image_asset_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "listen_policy": {
          "default": "free",
          "type": "string",
          "enum": [
            "once",
            "free"
          ]
        },
        "pause_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "explanation": {
      "type": "object",
      "properties": {
        "vi": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "ja": {
          "type": "string"
        },
        "ko": {
          "type": "string"
        },
        "th": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "string",
      "maxLength": 4000
    },
    "tags": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "word_limit": {
      "type": "object",
      "properties": {
        "max_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "allow_number": {
          "type": "boolean"
        },
        "number_only": {
          "type": "boolean"
        }
      }
    },
    "gaps": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "word_limit": {
            "type": "object",
            "properties": {
              "max_words": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "allow_number": {
                "type": "boolean"
              },
              "number_only": {
                "type": "boolean"
              }
            }
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "answer_key": {
      "type": "object",
      "properties": {
        "gaps": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "accepted": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "case_sensitive": {
                "type": "boolean"
              }
            },
            "required": [
              "accepted"
            ]
          }
        },
        "spelling_variants": {
          "type": "boolean"
        },
        "scoring": {
          "type": "string",
          "enum": [
            "partial",
            "all_or_nothing"
          ]
        }
      },
      "required": [
        "gaps"
      ]
    },
    "image_asset_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "image_alt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "labels": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "description"
        ]
      }
    }
  },
  "required": [
    "type",
    "answer_key",
    "image_asset_id",
    "image_alt",
    "labels"
  ]
}
