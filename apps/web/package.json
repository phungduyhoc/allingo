{
  "name": "@allingo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-sw.mjs",
    "dev": "next dev -p 3000",
    "dev:mock": "node scripts/build-sw.mjs && NEXT_PUBLIC_API_MOCK=1 next dev -p 3000",
    "sw:build": "node scripts/build-sw.mjs",
    "prebuild": "node scripts/build-sw.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@allingo/api-client": "workspace:*",
    "@allingo/i18n": "workspace:*",
    "@allingo/schemas": "workspace:*",
    "@allingo/scoring": "workspace:*",
    "@allingo/ui": "workspace:*",
    "@serwist/next": "^9.5.13",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "serwist": "^9.5.13",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
