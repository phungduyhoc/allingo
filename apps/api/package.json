{
  "name": "@allingo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Allingo API (NestJS trên Fastify) + worker BullMQ",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --watch --import @swc-node/register/esm-register src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi": "node --import @swc-node/register/esm-register scripts/export-openapi.ts",
    "openapi:diff": "node --import @swc-node/register/esm-register scripts/openapi-diff.ts",
    "eval:build": "node --import @swc-node/register/esm-register scripts/eval-build.ts",
    "poc:w": "node --import @swc-node/register/esm-register ../../eval/poc/writing/run-poc-w.ts",
    "poc:p": "node --import @swc-node/register/esm-register ../../eval/poc/pronunciation/run-poc-p.ts",
    "poc:typecheck": "tsc -p ../../eval/poc/tsconfig.json --noEmit",
    "start:dev": "node --import @swc-node/register/esm-register src/main.ts",
    "search:reindex": "node --import @swc-node/register/esm-register scripts/search-reindex.ts",
    "test-sets:generate": "node --import @swc-node/register/esm-register scripts/generate-test-set.ts",
    "seed:media": "node --import @swc-node/register/esm-register scripts/seed-media.ts",
    "eval:run": "node --import @swc-node/register/esm-register scripts/eval-run.ts",
    "push:vapid": "node --import @swc-node/register/esm-register scripts/gen-vapid.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/google": "^4.0.109",
    "@ai-sdk/openai": "^4.0.106",
    "@allingo/db": "workspace:*",
    "@allingo/fsrs": "workspace:*",
    "@allingo/planner": "workspace:*",
    "@allingo/schemas": "workspace:*",
    "@allingo/scoring": "workspace:*",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/websockets": "^12.3.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "ai": "^7.0.159",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "jose": "^6.1.0",
    "meilisearch": "^0.62.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@allingo/config": "workspace:*",
    "@nestjs/testing": "^12.3.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.21",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
