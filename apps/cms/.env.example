# apps/cms – biến môi trường mẫu (sao chép thành .env.local hoặc dùng .env ở gốc repo)
# KHÔNG đặt giá trị thật vào tệp này.

# Kết nối PostgreSQL dùng chung với API; Payload chỉ tạo bảng trong schema CMS_DATABASE_SCHEMA
DATABASE_URL=postgres://allingo:allingo@localhost:5432/allingo
CMS_DATABASE_SCHEMA=cms

# Khoá ký cookie/JWT của Payload (>= 32 ký tự ngẫu nhiên ở môi trường thật)
PAYLOAD_SECRET=dev-payload-secret-change-me

# URL công khai của CMS (serverURL) – dùng cho cookie/CSRF/preview
CMS_PUBLIC_URL=http://localhost:3001

# API nội bộ của apps/api (đồng bộ sang catalog, AI kiểm tra, danh mục tham chiếu)
INTERNAL_API_URL=http://localhost:4000/v1
INTERNAL_API_TOKEN=dev-internal-token

# Thư mục lưu tệp upload (mặc định apps/cms/media)
# CMS_MEDIA_DIR=./media
