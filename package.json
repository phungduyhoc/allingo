{
  "name": "allingo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Allingo — Ngoại ngữ cho tất cả: nền tảng luyện thi AI cho TOEIC, IELTS, JLPT, HSK",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @allingo/web test:e2e",
    "docker:up": "docker compose -f infra/docker/compose.dev.yml up -d",
    "docker:down": "docker compose -f infra/docker/compose.dev.yml down",
    "docker:reset": "docker compose -f infra/docker/compose.dev.yml down -v && pnpm docker:up",
    "db:migrate": "pnpm --filter @allingo/db migrate",
    "db:seed": "pnpm --filter @allingo/db seed",
    "db:diff": "pnpm --filter @allingo/db diff",
    "db:studio": "pnpm --filter @allingo/db studio",
    "api:openapi": "pnpm --filter @allingo/api openapi",
    "api:diff": "pnpm --filter @allingo/api openapi:diff",
    "client:gen": "pnpm --filter @allingo/api-client gen",
    "schemas:gen-ai": "pnpm --filter @allingo/schemas gen-ai",
    "eval:build": "pnpm --filter @allingo/api eval:build",
    "eval:run": "pnpm --filter @allingo/api eval:run",
    "report:beta": "pnpm --filter @allingo/api report:beta",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@allingo/config": "workspace:*",
    "autocannon": "^8.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.17": "3.4.17",
      "zod@<4.6.6": "4.6.7",
      "happy-dom@<21.0.4": "21.0.4"
    }
  }
}
