# =============================================================================
# Allingo – biến môi trường mẫu. Sao chép thành .env (gốc repo) cho dev.
# KHÔNG đặt giá trị thật vào tệp này. Validate lúc khởi động bằng Zod
# (apps/api/src/config/env.ts, apps/web/src/env.ts, apps/cms/src/env.ts).
# =============================================================================

# --- Chung ------------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=debug                     # trace | debug | info | warn | error
TZ=Asia/Ho_Chi_Minh

# --- Cơ sở dữ liệu ----------------------------------------------------------
# Vai trò migrate (có quyền tạo schema/extension) và vai trò runtime (không BYPASSRLS)
DATABASE_URL=postgres://allingo:allingo@localhost:5432/allingo
DATABASE_URL_MIGRATE=postgres://allingo:allingo@localhost:5432/allingo
DATABASE_URL_REPLICA=
TEST_DATABASE_URL=postgres://allingo:allingo@localhost:5432/allingo_test
DB_POOL_MAX=10
DB_QUERY_METRICS=true               # S11: histogram db_query_duration_seconds theo (op, bảng)
DB_SLOW_QUERY_MS=200                # S11: truy vấn ≥ ngưỡng → log cảnh báo (SQL tham số hoá, không giá trị) + db_slow_queries_total

# --- Redis / hàng đợi --------------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=allingo

# --- Lưu trữ S3 (MinIO dev) -------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_MEDIA=allingo-media
S3_BUCKET_RECORDINGS=allingo-recordings
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=600
S3_PUBLIC_BASE_URL=                 # CDN công khai cho bucket media (rỗng = URL ký); không áp dụng cho recordings
# Driver lưu trữ (Sprint 2, ADR-0025): s3 | fs; rỗng = tự chọn (APP_ENV=test → fs, còn lại → s3).
# fs: lưu tệp cục bộ + URL ký HMAC tới /v1/storage/fs/* – mặc định cho dev (MinIO ngừng phát hành image 09/2026, S143);
# staging/production đặt s3 (R2/Azure Blob…)
STORAGE_DRIVER=fs
STORAGE_FS_DIR=./.storage           # tương đối với thư mục chạy API (apps/api); tự tạo .gitignore bên trong

# --- Media pipeline & TTS (Sprint 2) ------------------------------------------
FFMPEG_PATH=ffmpeg                  # worker image phải có ffmpeg/ffprobe
FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_TIMEOUT_SECONDS=300
TTS_DEFAULT_VOICE=en-US-JennyNeural

# --- Tìm kiếm ---------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey-dev-only
SEARCH_PROVIDER=auto                # auto (Meilisearch nếu sẵn sàng, nếu không PostgreSQL) | meili | pg
SEARCH_INDEX_PREFIX=allingo_

# --- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CMS_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
RATE_LIMIT_MAX=300                  # yêu cầu / phút / IP
RATE_LIMIT_ALLOWLIST=127.0.0.1,::1  # S11: IP bỏ qua giới hạn theo IP (healthcheck nội bộ/test); staging/prod để trống hoặc IP probe
RATE_LIMIT_REDIS=true               # S11: store Redis cho giới hạn toàn cục (nhiều replica dùng chung); Redis mất → bỏ qua (fail-open)
RATE_LIMIT_BUCKETS_ENABLED=true     # S11: token bucket theo người dùng/IP cho explain/tutor/submit/orders/pay/otp/login/register/webhook
RATE_LIMIT_BUCKET_MULTIPLIER=1      # S11: nhân dung lượng + tốc độ nạp mọi bucket (load test có thể tăng)
CSRF_PROTECTION=true                # S11: kiểm Origin/Sec-Fetch-Site/Referer cho POST/PUT/PATCH/DELETE dùng cookie phiên + mọi POST /v1/auth/*
CSRF_TRUSTED_ORIGINS=               # S11: origin tin cậy bổ sung (ngoài CORS_ORIGINS, WEB/API/CMS_PUBLIC_URL)
SECURITY_HSTS_PRELOAD=false         # S11: thêm "preload" vào HSTS (chỉ bật khi đã đăng ký hstspreload cho domain)
LOGIN_MAX_FAILURES=10               # S11: số lần sai mật khẩu trong cửa sổ trước khi khoá đăng nhập theo email
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
AUTH_MIN_RESPONSE_MS=400            # S11: thời gian phản hồi tối thiểu login/register/otp (chống enumerate theo thời gian); 0 = tắt
BODY_LIMIT_BYTES=2097152
# Token dùng chung API ↔ CMS cho /v1/internal/* (header X-Internal-Token). Đổi trên staging/prod (Key Vault)
INTERNAL_API_TOKEN=dev-internal-token

# --- Xác thực (module iam, ADR-0022) -------------------------------------------
AUTH_SECRET=change-me-32-chars-minimum-random-string
AUTH_BASE_URL=http://localhost:4000/v1/auth
JWT_ACCESS_TTL_SECONDS=900          # 15 phút
JWT_REFRESH_TTL_SECONDS=2592000     # 30 ngày, xoay vòng
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OTP_DEV_FIXED_CODE=123456           # chỉ dev/test; rỗng ở prod
OTP_SENDER=auto                     # auto (email→SMTP, sms/zalo→console ở dev) | memory (test) | console
OTP_TTL_SECONDS=300                 # OTP hiệu lực 5 phút
OTP_MAX_ATTEMPTS=5                  # sai 5 lần → khoá
OTP_LOCK_MINUTES=30
OTP_REQUEST_LIMIT=3                 # tối đa 3 yêu cầu / cửa sổ
OTP_REQUEST_WINDOW_MINUTES=15
ESMS_API_KEY=                       # SMS OTP (eSMS) – stub Sprint 1
ZALO_ZNS_ACCESS_TOKEN=              # Zalo ZNS OTP – stub Sprint 1
OAUTH_MOCK=false                    # true: provider "mock" cho dev/test (id_token dạng mock:<uid>:<email>:<name>)
APPLE_TEAM_ID=                      # Sign in with Apple: tạo client_secret JWT từ TEAM_ID/KEY_ID/PRIVATE_KEY khi đổi code
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                  # PEM (p8), xuống dòng thay bằng \n
POLICY_VERSION=2026-11              # phiên bản điều khoản/chính sách hiện hành (consents)
PURGE_DELAY_MINUTES=4320            # xoá tài khoản sau 72 giờ (đặt 1 ở dev để thử)
PURGE_SCAN_INTERVAL_SECONDS=600
TURNSTILE_SECRET=

# --- Email (Mailpit dev) -----------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Allingo <no-reply@allingo.vn>"

# --- AI Gateway --------------------------------------------------------------
AI_PROVIDER=mock                    # mock | live (live = theo ai.model_routes)
AI_TRACE_CONTENT=false              # không ghi nội dung bài làm vào trace
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
CLAUDE_SONNET_MODEL=claude-sonnet-4-5
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
OPENAI_GPT_MODEL=gpt-5
OPENAI_GPT_MINI_MODEL=gpt-5-mini
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
ALLOW_UNEVALUATED_ACTIVATION=false  # true chỉ có tác dụng khi APP_ENV=development|test (bỏ cổng eval khi kích hoạt prompt)
LANGFUSE_FLUSH_INTERVAL_MS=2000
# Sprint 5 – retry có jitter (chỉ lỗi tạm thời) và circuit breaker theo provider (mở sau 5 lỗi/60 s, half-open sau 60 s)
AI_RETRY_MAX=2
AI_RETRY_BASE_MS=300
AI_BREAKER_FAILURES=5
AI_BREAKER_WINDOW_MS=60000
AI_BREAKER_OPEN_MS=60000
# Embedding dedup câu sinh AI (ai.embeddings vector(1536)): auto | mock | google | openai
AI_EMBEDDING_PROVIDER=auto
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_DEDUP_COSINE_THRESHOLD=0.92
# Job nền (content.generate, summary.attempt, eval.run): true = chạy trong process API khi không chạy worker (dev)
JOBS_INLINE=false
# GET /v1/metrics (Prometheus) – Bearer token; trống → INTERNAL_API_TOKEN
METRICS_TOKEN=
# Gia sư AI (Sprint 6): ngân sách token cho ngữ cảnh + lịch sử tutor_chat (ước lượng ký tự/4)
AI_TUTOR_CONTEXT_TOKENS=1800

# --- Web Push (Sprint 6, VAPID) ------------------------------------------------
# Sinh cặp khoá dev: pnpm --filter @allingo/api push:vapid  (KHÔNG commit khoá thật; staging/prod lấy từ Key Vault)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@allingo.vn
PUSH_SENDER=auto                    # auto (web-push khi có khoá) | webpush | memory (sender giả, test)
PUSH_TTL_SECONDS=3600

# --- Speech (Azure) ----------------------------------------------------------
SPEECH_PROVIDER=mock                # mock | azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# --- Thanh toán (sandbox; Sprint 7, ADR-0012 webhook-first, docs/runbooks/payments.md) ----------
# Cổng bật; cổng thiếu credential → không liệt kê cho client (GET /v1/payments/providers). mock bị chặn ở production.
PAYMENT_PROVIDERS=mock              # mock,vnpay,momo,zalopay
# URL công khai cổng gọi IPN/return (rỗng = API_PUBLIC_URL). Sandbox cần https công khai (vd ngrok) để nhận IPN.
PAYMENT_CALLBACK_BASE_URL=
ORDER_EXPIRE_MINUTES=30             # đơn pending hết hạn (job order.expire)
PAYMENT_RECONCILE_AFTER_MINUTES=15  # đơn pending quá N phút → payment.reconcile hỏi queryStatus
PAYMENT_HTTP_TIMEOUT_MS=15000
PAYMENT_MOCK_SECRET=mock-dev-secret # chỉ dev/test (ký webhook giả lập)
# VNPay 2.1.0 – lấy TMN code + hash secret từ email đăng ký sandbox (KHÔNG commit giá trị thật)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# MoMo AIO v2 – partner code/access key/secret key từ business.momo.vn (môi trường test)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_REQUEST_TYPE=captureWallet     # captureWallet | payWithMethod | payWithATM | payWithCC
# ZaloPay API v2 – app_id, key1 (tạo đơn/truy vấn), key2 (xác minh callback)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn
# Lịch job billing trong process API (worker luôn chạy). Tự bật khi JOBS_INLINE=true (dev không chạy worker)
BILLING_SCHEDULER_IN_API=false

# --- Hoá đơn điện tử (Sprint 8, ADR-0030 – Proposed, docs/runbooks/invoices.md) -----------------------
EINVOICE_PROVIDER=mock              # mock (PDF tự dựng, dev/test) | misa (MISA meInvoice) | viettel (khung)
EINVOICE_VAT_RATE=KCT               # KCT (không chịu thuế – cần kế toán xác nhận) | 0 | 5 | 8 | 10 (giá đã gồm thuế)
EINVOICE_SELLER_NAME="CONG TY TNHH ALLINGO (DEV)"
EINVOICE_SELLER_TAX_CODE=0000000000
EINVOICE_SELLER_ADDRESS="Ha Noi, Viet Nam"
EINVOICE_HTTP_TIMEOUT_MS=20000
# MISA meInvoice – API tích hợp (môi trường test). KHÔNG commit giá trị thật
MISA_MEINVOICE_BASE_URL=https://testapi.meinvoice.vn/api/integration
MISA_MEINVOICE_APP_ID=
MISA_MEINVOICE_TAX_CODE=
MISA_MEINVOICE_USERNAME=
MISA_MEINVOICE_PASSWORD=
MISA_MEINVOICE_INV_SERIES=1C26TAA   # ký hiệu hoá đơn đã đăng ký với CQT
MISA_MEINVOICE_SIGN_TYPE=2          # 2 = ký bằng HSM của MISA
# Viettel SInvoice (khung – chưa gọi thật ở S8)
VIETTEL_SINVOICE_BASE_URL=https://api-vinvoice.viettel.vn/services/einvoiceapplication/api
VIETTEL_SINVOICE_USERNAME=
VIETTEL_SINVOICE_PASSWORD=
VIETTEL_SINVOICE_TEMPLATE_CODE=1/001
VIETTEL_SINVOICE_INV_SERIES=C26TAA
S3_BUCKET_INVOICES=allingo-invoices # bucket riêng cho PDF hoá đơn (URL ký 10 phút)

# --- Thông báo đa kênh (Sprint 8) --------------------------------------------------------------------
EMAIL_PROVIDER=auto                 # auto (test → memory, còn lại smtp/Mailpit) | smtp | resend | ses | memory
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
SES_REGION=ap-southeast-1
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_REPLY_TO=
NOTIFY_UNSUBSCRIBE_SECRET=          # trống → dẫn xuất từ AUTH_SECRET
OPS_ALERT_EMAIL=                    # nhận cảnh báo vận hành (hoá đơn dead-letter); trống → chỉ in-app cho admin

# --- Referral (Sprint 8) ------------------------------------------------------------------------------
REFERRAL_SHARE_BASE_URL=            # trống → ${API_PUBLIC_URL}/v1/r (trang OG + chuyển hướng về web)
REFERRAL_OG_IMAGE_URL=              # trống → ${WEB_PUBLIC_URL}/og/referral.png

# --- Quan sát -----------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=allingo-api
OTEL_TRACES_SAMPLER_RATIO=1         # S11: tỉ lệ lấy mẫu trace (staging 1, production 0.1–0.2)
SENTRY_DSN=                         # S11: trống → tắt báo lỗi; có → adapter Envelope HTTP (không SDK), PII đã che
SENTRY_RELEASE=                     # S11: tag release (trống → GIT_SHA → allingo@<version>); pipeline đặt = sha image
SENTRY_SAMPLE_RATE=1
WORKER_METRICS_PORT=9464            # S11: GET /metrics của worker (Bearer METRICS_TOKEN); 0 = tắt
CATALOG_CACHE_TTL_SECONDS=30        # S11: cache trong process câu theo question_version_id (nội dung bất biến; thống kê cộng đồng trễ ≤ TTL); 0 = tắt
FLAGS_CACHE_TTL_SECONDS=15          # S11: cache Redis feature flag; PUT /admin/flags xoá ngay + pub/sub → kill-switch < 60 s
QUEUE_BACKPRESSURE_GRADING_DEPTH=200 # S11: grading ≥ N job chờ → tạm dừng worker notify/analytics tới khi ≤ N/2
POSTHOG_KEY=                        # Sprint 10: có khoá → API gửi sự kiện phễu server-side (signup_done, diagnostic_done, first_attempt, order_paid)
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_SINK=auto                 # auto | posthog | memory | none (auto: có POSTHOG_KEY → posthog; test → memory)
ANALYTICS_HASH_SALT=                # muối băm distinct_id = sha256(salt:user_id); trống → dẫn xuất AUTH_SECRET
STATS_CACHE_TTL_SECONDS=3600        # cache GET /me/stats (xoá khi attempt.graded / ôn thẻ / sổ lỗi)
WEEKLY_SUMMARY_HOUR_VN=8            # giờ gửi tóm tắt tuần sáng thứ Hai (giờ VN)
# DATABASE_URL_REPLICA (ở trên): module analytics đọc replica; trống → cùng DB với SET TRANSACTION READ ONLY

# --- Sprint 12: beta kín, hỗ trợ, admin, bảo mật -----------------------------
# Beta gate bật/tắt qua flag ff.growth.beta_gate (rules.config ghi đè trial/credit/hạn mức mời) – không cần env
BETA_INVITE_SEND_HOUR_VN=9          # giờ VN job beta.invites_send gửi đợt mời trong ngày (≤ daily_invite_limit)
ADMIN_MFA_REQUIRED=auto             # auto (bật ở staging/production) | true | false – TOTP step-up cho endpoint admin
MFA_ENCRYPTION_KEY=                 # khoá AES-256-GCM mã hoá secret TOTP; trống → dẫn xuất AUTH_SECRET (đặt riêng trên prod)
MFA_ISSUER=Allingo                  # tên hiển thị trong app Authenticator
MFA_SESSION_MAX_AGE_HOURS=12        # step-up MFA còn hiệu lực bao lâu trên một phiên
PASSWORD_MIN_LENGTH=12              # độ dài tối thiểu mật khẩu khi đăng ký (pentest-1)
PASSWORD_BREACH_CHECK=true          # chặn mật khẩu trong danh sách lộ offline + biến thể yếu
PASSWORD_HIBP_ENABLED=false         # thêm kiểm HIBP k-anonymity (5 ký tự đầu SHA-1); lỗi mạng → bỏ qua (fail-open)
PASSWORD_HIBP_URL=https://api.pwnedpasswords.com/range
PASSWORD_HIBP_TIMEOUT_MS=1500
REFUND_POLICY_VERSION=2026-11       # phiên bản văn bản chính sách hoàn tiền (GET /legal/policies)
VOICE_CONSENT_VERSION=2026-11       # phiên bản văn bản đồng ý xử lý giọng nói (consent voice_processing)
CONTENT_STATS_HOUR_VN=2             # job content.stats_nightly (p-value, point-biserial, đề xuất retire)
CONTENT_STATS_WINDOW_DAYS=365
CONTENT_STATS_MIN_N=30              # số lượt tối thiểu trước khi đề xuất review/retire
RETENTION_HOUR_VN=3                 # job ops.retention_cleanup (docs/runbooks/data-retention.md)
RETENTION_AI_TASKS_DAYS=180
RETENTION_OUTBOX_DAYS=30
RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_AUDIT_DAYS=730            # tối thiểu 365; chờ pháp chế xác nhận (SPEC-ISSUES S133)
RETENTION_DEADLETTER_DAYS=90
RETENTION_BATCH=1000
BILLING_REPORT_EMAILS=              # nhận email đối soát thanh toán hằng ngày (phân cách dấu phẩy); trống → OPS_ALERT_EMAIL
BETA_REPORT_EMAILS=                 # nhận `pnpm report:beta -- --email`; trống → OPS_ALERT_EMAIL
POSTHOG_API_HOST=https://us.posthog.com   # API đọc (HogQL) cho báo cáo beta – khác POSTHOG_HOST (ingest)
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=           # personal API key quyền query; trống → mục PostHog trong báo cáo ghi "chưa có"

# --- Web (Next.js) -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- CMS (Payload) -----------------------------------------------------------
PAYLOAD_SECRET=change-me-payload-secret
CMS_PORT=3001
CMS_DATABASE_SCHEMA=cms
INTERNAL_API_URL=http://localhost:4000/v1   # CMS gọi API nội bộ (/v1/internal/*), dùng INTERNAL_API_TOKEN ở trên
# Sprint 10 – CMS gọi webhook revalidate của web khi pages/posts/redirects xuất bản/đổi/xoá (trống → không gọi)
WEB_REVALIDATE_URL=                 # vd http://localhost:3000/api/revalidate
WEB_REVALIDATE_SECRET=              # ≥ 16 ký tự; web kiểm x-allingo-signature = sha256=HMAC_SHA256(secret, "<x-allingo-timestamp>.<body>")
CMS_MEDIA_DIR=                      # thư mục tệp upload của Payload (rỗng = apps/cms/media)
