{
  "//": "Typecheck riêng cho PoC (eval/poc không thuộc runtime): pnpm --filter @allingo/api poc:typecheck",
  "extends": "../../apps/api/tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
